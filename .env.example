# Maurya Technical Environment Configuration
# Copy this file to .env and fill in your actual SMTP / Email credentials

# Django Secret Key & Debug Mode
DEBUG=True
SECRET_KEY=django-insecure-maurya-technical-secret-key-2026

# Email SMTP Settings (For sending real OTP emails to students)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=director@mauryatechnical.in
EMAIL_HOST_PASSWORD=your_16_digit_app_password_here
DEFAULT_FROM_EMAIL=Maurya Technical <director@mauryatechnical.in>
SERVER_EMAIL=director@mauryatechnical.in
